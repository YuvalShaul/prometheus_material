{
  "title": "Flask Shop Metrics",
  "uid": "flask-shop-metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Order Rate by Category (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(shop_orders_total[1m])) by (category)",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 8 },
      "targets": [
        {
          "expr": "shop_active_users",
          "legendFormat": "users"
        }
      ]
    },
    {
      "id": 3,
      "title": "Payment Duration — p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(shop_payment_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    }
  ]
}
